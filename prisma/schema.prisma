generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------
// Auth (NextAuth.js required models)
// -----------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?   // nullable: Google OAuth users won't have a password
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  applications Application[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------
// Application domain
// -----------------------------------------------

enum WorkModel {
  REMOTE
  HYBRID
  ONSITE
}

enum ApplicationStatus {
  APPLIED      // Candidatura enviada
  SCREENING    // Em triagem
  INTERVIEW    // Em entrevista
  OFFER        // Oferta recebida
  REJECTED     // Rejeitado
  GHOSTED      // Sem resposta
}

model Application {
  id          String            @id @default(cuid())
  userId      String
  jobTitle    String
  company     String
  jobUrl      String?
  platform    String            // LinkedIn, Gupy, Indeed, etc.
  workModel   WorkModel         @default(REMOTE)
  location    String?
  salary      String?           // faixa salarial como texto (ex: "R$ 8.000 - R$ 12.000")
  tags        String[]          // stacks/requisitos como array de strings
  description String?
  status      ApplicationStatus @default(APPLIED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stages Stage[]
  notes  Note[]
}

model Stage {
  id              String      @id @default(cuid())
  applicationId   String
  name            String      // ex: "Entrevista técnica", "Entrevista com RH"
  order           Int         @default(0)
  completed       Boolean     @default(false)
  scheduledAt     DateTime?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageNotes  Note[]
}

model Note {
  id            String   @id @default(cuid())
  applicationId String
  stageId       String?  // nullable: note can belong to a stage or just to the application
  content       String
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage       Stage?      @relation(fields: [stageId], references: [id], onDelete: SetNull)
}
